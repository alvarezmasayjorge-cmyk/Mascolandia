generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("RECEPCIONISTA")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultations      Consultation[]
  inventoryMovements InventoryMovement[]
  evolutions         Evolution[]
  appointments       Appointment[]
  refreshTokens      RefreshToken[]
}

model Patient {
  id            Int      @id @default(autoincrement())
  recordNumber  String   @unique

  ownerName     String
  ownerAddress  String
  ownerPhone    String

  name          String
  species       String
  breed         String?
  age           String?
  weight        Float?
  gender        String?
  color         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vaccinations  Vaccination[]
  dewormings    Deworming[]
  consultations Consultation[]
  appointments  Appointment[]

  @@index([species])
  @@index([ownerName])
  @@index([updatedAt])
}

model Vaccination {
  id        Int      @id @default(autoincrement())
  patientId Int
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type      String   // Parvovirus, Rabia, etc.
  date      DateTime
}

model Deworming {
  id        Int      @id @default(autoincrement())
  patientId Int
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date      DateTime
}

model Consultation {
  id                  Int      @id @default(autoincrement())
  number              String   @unique
  date                DateTime @default(now())
  status              String   @default("COMPLETADA")

  patientId           Int
  patient             Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  vetId               Int
  vet                 User     @relation(fields: [vetId], references: [id])

  reason              String
  prevDiseases        String?
  prevInterventions   String?

  generalState        String?
  mucosa              String?
  appetite            String?
  hydration           String?
  temperature         Float?
  respirationType     String?
  respRate            Int?
  heartRate           Int?
  digestiveSystem     String?
  genitourinarySystem String?
  requestedExams      String?

  diagnosis           String?
  prognosis           String?
  treatment           String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  evolutions          Evolution[]
  inventoryMovements  InventoryMovement[]

  @@index([patientId])
  @@index([date])
  @@index([status])
}

model Evolution {
  id             Int      @id @default(autoincrement())
  consultationId Int
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  userId         Int
  user           User     @relation(fields: [userId], references: [id])

  date           DateTime @default(now())
  text           String

  @@index([consultationId])
}

model InventoryItem {
  id            Int      @id @default(autoincrement())
  name          String
  category      String
  stock         Float
  unit          String
  expiryDate    DateTime?
  costPrice     Float?
  sellingPrice  Float?
  supplier      String?
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  movements     InventoryMovement[]

  @@index([expiryDate])
  @@index([stock])
}

model InventoryMovement {
  id             Int      @id @default(autoincrement())
  itemId         Int
  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type           String
  quantity       Float
  date           DateTime @default(now())
  userId         Int
  user           User     @relation(fields: [userId], references: [id])

  consultationId Int?
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([date])
}

model Appointment {
  id        Int      @id @default(autoincrement())
  patientId Int?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  vetId     Int?
  vet       User?    @relation(fields: [vetId], references: [id])

  date      DateTime
  reason    String?
  status    String   @default("PENDIENTE")

  createdAt DateTime @default(now())

  @@index([date])
  @@index([vetId, date])
}

model CashTransaction {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  description String
  amount      Float
  category    String
  type        String

  createdAt   DateTime @default(now())

  @@index([date])
  @@index([type])
}

model Counter {
  name  String @id
  value Int    @default(0)
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

model ClinicSettings {
  id       Int     @id @default(autoincrement())
  name     String  @default("Mascolandia")
  address  String  @default("")
  phone    String  @default("")
  email    String  @default("")
  logoUrl  String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
