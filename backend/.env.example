# Database
# Local SQLite:  DB_PROVIDER=sqlite    DATABASE_URL=file:./dev.db
# Railway/Prod:  DB_PROVIDER=postgresql DATABASE_URL=postgresql://...
DB_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# JWT
# Generar con: openssl rand -hex 32
JWT_SECRET="your-secret-key-min-32-bytes-random"
JWT_REFRESH_SECRET="your-refresh-secret-key-min-32-bytes-random"

# Server
PORT=5001
NODE_ENV="development"

# CORS
# Desarrollo local: http://localhost:5173,http://localhost:5174
# Producción: https://mascolandia.com,https://www.mascolandia.com
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Rate Limiting (intentos fallidos de login)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=10
